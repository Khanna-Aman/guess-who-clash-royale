# ─────────────────────────────────────────────────────────────────────────────
# Example environment file for running the card-update pipeline locally.
#
#   cp .env.example .env      then fill in your own key
#
# The real .env is gitignored and must NEVER be committed.
# In GitHub Actions the key comes from a repo secret, NOT this file:
#   Settings → Secrets and variables → Actions → GEMINI_API_KEY
#
# Get a free key at https://aistudio.google.com/  (Gemini API).
# If a key is ever exposed, rotate it there immediately.
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
